# Gitignore for Multi-Tenant Invoicing System

# Docs
docs.docx

# Node.js and npm/yarn related files
node_modules/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.npm/

# Backend specific
backend/logs/
backend/*.log
backend/tmp/
backend/.env
backend/.env.local
backend/.env.development.local
backend/venv/
backend/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd

# Explicitly ignore Python virtual environment folders anywhere
**/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Frontend specific (React)
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/coverage/
frontend/.env
frontend/.env.*.local
frontend/reportWebVitals.js

# IDE and OS-specific files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Logs and temporary files
logs/
*.log
*.tmp
*~

**/venv/
**/__pycache__/
**/*.pyc

