# Copy this to .env (same directory as docker-compose.yml) and fill in real values.
# .env is gitignored — never commit the real one.

# --- Public URL this app is served at (no trailing slash) ---
PUBLIC_URL=https://joslazip.com

# --- Postgres ---
DB_USER=admin
DB_PASSWORD=change-me-to-a-real-password
MASTER_DB_NAME=invoicedb

# --- Auth secrets (generate with: openssl rand -hex 32) ---
JWT_SECRET=
REFRESH_SECRET=

# --- Master login (hardcoded admin account) ---
MASTER_USERNAME=admin@joslazip.com
MASTER_PASSWORD=change-me-to-a-real-password

# --- Allowed hostnames (comma-separated, no scheme) ---
# Must include "localhost" — the backend's own Docker healthcheck calls
# itself over http://localhost:8000/, and TrustedHostMiddleware 400s that
# request if "localhost" isn't in this list, which marks the container
# unhealthy and can take the whole deployment down.
ALLOWED_HOSTS=joslazip.com,www.joslazip.com,localhost

# --- SMTP (optional — leave blank to disable email sending) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=JoslaSync

# --- Cookies (true in production over HTTPS) ---
COOKIE_SECURE=true
